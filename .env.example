# ==============================================================================
# FÁBRICA DE WEBS — Variables de Entorno de Referencia (.env.example)
# Copia este archivo como .env.local para desarrollo o configúralo en Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURIDAD & PORTAL DIRECTIVO (EDGE RUNTIME)
# ------------------------------------------------------------------------------
# Clave criptográfica aleatoria de 32+ caracteres para firmar los Magic Links (HS256).
# OBLIGATORIO EN PRODUCCIÓN para evitar que terceros firmen tokens de acceso.
PORTAL_JWT_SECRET=tu_clave_secreta_aleatoria_minimo_32_caracteres

# ------------------------------------------------------------------------------
# 2. GOOGLE ANALYTICS 4 DATA API (NODE.JS SERVER RUNTIME)
# ------------------------------------------------------------------------------
# ID numérico de la propiedad GA4 (NO usar Measurement ID tipo G-XXXXXXXXXX).
# En Google Analytics: Administrar -> Configuración de la Propiedad -> ID de la Propiedad.
GA4_PROPERTY_ID=560524900

# Service Account de Google Cloud con rol "Lector" en la propiedad de GA4.
GA4_CLIENT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com

# Clave privada PEM de la Service Account de Google Cloud.
# En Vercel / .env.local debe incluir los saltos de línea escapados: \n
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# (Opcional en Local) Ruta al archivo de credenciales de GCP descargado:
# GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# ------------------------------------------------------------------------------
# 3. CONVERSIÓN & FORMULARIOS (RESEND)
# ------------------------------------------------------------------------------
# Clave API de Resend para envío transaccional de leads desde Server Actions.
RESEND_API_KEY=re_tu_api_key_aqui

# Email destinatario donde el equipo comercial recibe las alertas de nuevos leads.
CONTACT_EMAIL_TO=contacto@tudominio.com

# Remitente de correo verificado en Resend (opcional, default: onboarding@resend.dev)
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SITIO & SEO
# ------------------------------------------------------------------------------
# URL canónica de producción del sitio web.
NEXT_PUBLIC_SITE_URL=https://excursiones.adaroviajes.com
